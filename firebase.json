{
  "firestore": {
    "location": "europe-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": { "rules": "storage.rules" },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules", ".git", ".firebase", ".claude", "firebase-debug.log", "firestore-debug.log",
        "dist/**", "src/**", "admin/**", "public/**", "outputs/**", "planning/**", "backend/test/**", "backend/scripts/**", "backend/.emulator-data/**"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "europe-west1" } },
      { "source": "/admin/**", "destination": "/admin/index.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8085 },
    "auth": { "host": "127.0.0.1", "port": 9109 },
    "storage": { "host": "127.0.0.1", "port": 9209 },
    "ui": { "enabled": false },
    "singleProjectMode": false
  }
}
